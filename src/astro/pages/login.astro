---
// 로그인 페이지 정적 셸. 기존 public/login.html 과 동일한 마커/구조를 유지한다.
// - .wiki-logo-container#logoContainer: BaseLayout/컴포넌트 베이킹이 WIKI_LOGO_URL 로 로고 인라인.
// - .app-wiki-name: 빌드 타임에 WIKI_NAME 으로 베이킹.
// - #loginMessage / #auth-providers-container / #btnTerms / #btnPrivacy: /dist/login.js 가 채움.
// 인라인 <style> 은 전역 셀렉터(body 등)이므로 is:inline 으로 위치/내용 그대로 보존(스코프/번들 금지).
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout pagePath="/login.html" title="KidsWiki - 로그인">
    <style slot="head" is:inline>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: var(--wiki-bg);
            margin: 0;
            position: relative;
            overflow: hidden;
        }

        .login-container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 420px;
            padding: 3rem 2rem;
            /* 상단 그라데이션 띠(::before)를 모서리 곡률에 맞춰 자른다. */
            overflow: hidden;
            background: var(--wiki-glass-bg);
            backdrop-filter: var(--wiki-glass-blur);
            -webkit-backdrop-filter: var(--wiki-glass-blur);
            border: 1px solid var(--wiki-glass-border);
            border-radius: 24px;
            box-shadow: var(--wiki-shadow-lg);
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        /* 카드 상단 강조 띠 — 로그인은 위키 첫인상이라 브랜드 두 색을 여기서 한 번 보여준다.
           두 색 모두 토큰이라 스킨을 바꾸면 띠도 함께 바뀐다. */
        .login-container::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 6px;
            background: linear-gradient(90deg, var(--wiki-primary), var(--wiki-accent));
        }

        .login-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.1), 0 10px 15px -6px rgba(0, 0, 0, 0.1);
        }

        .logo-img {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 1.5rem;
            border-radius: 16px;
            box-shadow: var(--wiki-shadow-md);
            background: white;
            padding: 8px;
        }

        .welcome-text {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--wiki-text);
            margin-bottom: 0.5rem;
            /* 테마 제목 서체를 따른다(스킨이 --wiki-font-heading 을 덮으면 함께 바뀜).
               리터럴 'Outfit' 을 박아두면 스킨의 제목 서체가 이 문구만 비껴간다. */
            font-family: var(--wiki-font-heading);
        }

        .message-text {
            font-size: 0.95rem;
            color: var(--wiki-text-muted);
            margin-bottom: 2.5rem;
            line-height: 1.6;
        }

        .btn-oauth {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 12px 20px;
            font-size: 1rem;
            font-weight: 600;
            color: var(--wiki-text);
            background: var(--wiki-card-bg);
            border: 1px solid var(--wiki-border);
            border-radius: 12px;
            transition: all 0.2s ease;
            text-decoration: none;
            box-shadow: var(--wiki-shadow-sm);
            margin-bottom: 10px;
        }

        .btn-oauth:last-child {
            margin-bottom: 0;
        }

        .btn-oauth:hover {
            background: var(--wiki-bg);
            border-color: var(--wiki-primary);
            transform: translateY(-2px);
            box-shadow: var(--wiki-shadow);
            color: var(--wiki-primary);
        }

        .oauth-icon {
            width: 24px;
            height: 24px;
        }
    </style>

    <div class="login-container">
        <div class="wiki-logo-container" id="logoContainer">
            <!-- Logo injected by SSR -->
        </div>
        <h1 class="welcome-text"><span class="app-wiki-name">KidsWiki</span>에 오신 것을 환영합니다</h1>
        <p class="message-text" id="loginMessage">비공개 위키입니다. 로그인 후 이용해주세요.</p>

        <div id="auth-providers-container">
            <!-- JS로 공급자 버튼 동적 주입 -->
        </div>

        <div class="d-flex align-items-center justify-content-center gap-2 mt-3">
            <input class="form-check-input m-0" type="checkbox" id="rememberMe">
            <label class="form-check-label text-muted" for="rememberMe" style="font-size:0.85rem; cursor:pointer;">로그인
                유지</label>
        </div>

        <div class="mt-4 pt-3" style="border-top:1px solid var(--wiki-border);">
            <button type="button" id="btnQrLogin" class="btn btn-sm btn-link text-muted p-0"
                style="font-size:0.9rem; text-decoration:none;">
                <i class="mdi mdi-qrcode-scan"></i> 다른 기기로 로그인 (QR)
            </button>
        </div>

        <div class="mt-3 d-flex justify-content-center gap-3">
            <button type="button" id="btnTerms" class="btn btn-sm btn-link text-muted p-0"
                style="font-size:0.85rem;">이용약관</button>
            <button type="button" id="btnPrivacy" class="btn btn-sm btn-link text-muted p-0" style="font-size:0.85rem;">개인정보
                처리방침</button>
        </div>
    </div>

    <script slot="scripts" type="module" src="/dist/login.js" is:inline></script>
</BaseLayout>
